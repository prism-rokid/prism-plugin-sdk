{
  "compilerOptions": {
    "target": "ES2022",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "declaration": true,
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "example"]
}
