{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rokid-Prism/prism-plugin-sdk/blob/main/conformance/plugin-release.schema.json",
  "title": "Prism plugin release metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugin_id", "version", "plugin_protocol_version", "channel", "assets"],
  "properties": {
    "schema_version": { "const": 1 },
    "plugin_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "plugin_protocol_version": { "const": "4" },
    "min_hub_version": { "type": "string", "maxLength": 128 },
    "channel": { "const": "stable" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "filename", "sha256", "size_bytes"],
        "properties": {
          "platform": { "enum": ["macos-arm64", "macos-x64", "windows-x64", "linux-x64"] },
          "filename": { "type": "string", "pattern": "^[^/\\\\]+$", "maxLength": 512 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
